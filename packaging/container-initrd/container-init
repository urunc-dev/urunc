#!/busybox sh
# Superseded by urunit itself (NOFireAI/urunit), which runs as /init and
# /vz-init. Kept for INITRD_LAYOUT=legacy.
# Early userspace of a generic container boot (rdinit=/init).
#
# urunc boots an unmodified OCI image with a host kernel and this initrd. The
# container rootfs reaches the guest as a shared filesystem (virtiofs or 9p),
# described by the usual root=, rootfstype= and rootflags= parameters on the
# kernel command line. With an initramfs present the kernel leaves mounting
# that root to early userspace, so this script does exactly what has to happen
# before urunit can take over as PID 1, and nothing more:
#   1. mount the shared rootfs at /newroot;
#   2. move urunit, urunit-agent and the urunit configuration into it, under
#      /run/urunc (switch_root deletes the initramfs, so nothing may stay here);
#   3. switch_root into urunit with the container command, pointing it at its
#      configuration with URUNIT_CONFIG.
#
# The configuration (/urunit.conf) is the only per-container file urunc appends
# to this initrd: the container's environment, user and working directory.
# urunit, as PID 1, starts the agent it finds at /run/urunc/urunit-agent
# before the container command and reaps it, which is why this script only
# stages the agent there and never starts it.
# Everything else (the command line, the network files bind-mounted over
# /etc/resolv.conf, /etc/hosts and /etc/hostname, the volumes) already reaches
# the guest through the kernel command line and the shared rootfs itself.
#
# hull on macOS has no bind mounts to prepare the rootfs with, so it appends a
# few more files, all named /urunc-*. Each is handled in a block marked "hull"
# below and ignored when absent, which is the case on every Linux host:
#   /urunc-epoch       the host time in seconds; hvi has no RTC
#   /urunc-rosetta     run an amd64 rootfs under Rosetta (Vz)
#   /urunc-overlay     keep the shared root read-only under a tmpfs overlay
#   /urunc-mounts      extra virtio-fs exports: <tag>\t<guest path>\t<ro|rw>
#   /urunc-resolv.conf, /urunc-hosts, /urunc-hostname  the network files
#   /urunc-cmd         the container command, one argument per line
#
# urunit mounts /proc and /sys in the new root itself and fails when they are
# already mounted, so they are not mounted there here. The devtmpfs this script
# needs for the console is moved into the new root rather than mounted twice,
# since urunit opens the console device and nothing else would provide /dev;
# devpts is mounted on it because the agent's tty sessions need /dev/pts.
BB=/busybox

fail() {
  echo "container-init: $*" >&2
  # Exiting as PID 1 panics the kernel; with panic=-1 that reboots the guest,
  # which the monitor turns into an exit, so the container fails instead of
  # hanging with a dead init.
  exit 1
}

$BB mount -t proc proc /proc || fail "could not mount /proc"
$BB mount -t devtmpfs dev /dev || fail "could not mount /dev"

# hull: seed the clock from the host before anything checks a certificate.
if [ -s /urunc-epoch ]; then
  _epoch=$($BB cat /urunc-epoch)
  case "$_epoch" in
    ''|*[!0-9]*) ;;
    *) $BB date -u -s "@$_epoch" >/dev/null 2>&1 ;;
  esac
fi

# hull: register Rosetta for amd64 ELF binaries. The F flag opens the
# interpreter now, so the registration survives switch_root.
if [ -f /urunc-rosetta ]; then
  $BB mkdir -p /mnt/rosetta /proc/sys/fs/binfmt_misc
  $BB mount -t virtiofs rosetta /mnt/rosetta || fail "could not mount the rosetta share"
  $BB mount -t binfmt_misc none /proc/sys/fs/binfmt_misc || fail "could not mount binfmt_misc"
  $BB printf '%s' ':rosetta:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/mnt/rosetta/rosetta:OCF' > /proc/sys/fs/binfmt_misc/register \
    || fail "could not register the rosetta handler"
  $BB umount /proc/sys/fs/binfmt_misc
fi

# The root the kernel was told about: root=<tag> rootfstype=<fs> [rootflags=<opts>].
# Parameters after "--" belong to the container command and are not looked at.
root=""
fstype=""
flags=""
for _p in $($BB cat /proc/cmdline); do
  case "$_p" in
    --)           break ;;
    root=*)       root="${_p#root=}" ;;
    rootfstype=*) fstype="${_p#rootfstype=}" ;;
    rootflags=*)  flags="${_p#rootflags=}" ;;
  esac
done
[ -n "$root" ] && [ -n "$fstype" ] || fail "no root= and rootfstype= on the kernel command line"

# hull: the shared root is the unpacked image, read-only for every instance,
# so it becomes the lower layer of a tmpfs overlay and guest writes stay in
# the guest. Without the file the root is mounted directly, as on Linux.
if [ -f /urunc-overlay ]; then
  lower=/lowerroot
else
  lower=/newroot
fi
$BB mkdir -p "$lower"
if [ -n "$flags" ]; then
  $BB mount -t "$fstype" -o "$flags" "$root" "$lower" || fail "could not mount $fstype root $root ($flags)"
else
  $BB mount -t "$fstype" "$root" "$lower" || fail "could not mount $fstype root $root"
fi
if [ -f /urunc-overlay ]; then
  $BB mkdir -p /newroot /run/urunc-overlay
  $BB mount -t tmpfs tmpfs /run/urunc-overlay || fail "could not mount the overlay tmpfs"
  $BB mkdir -p /run/urunc-overlay/upper /run/urunc-overlay/work
  $BB mount -t overlay overlay \
    -o lowerdir=/lowerroot,upperdir=/run/urunc-overlay/upper,workdir=/run/urunc-overlay/work \
    /newroot || fail "could not mount the overlay over $root"
fi
$BB umount /proc

# urunit, the agent and the configuration live in this initramfs, which
# switch_root deletes; keep them in the new root's /run/urunc, where urunit
# looks for the agent.
[ -x /urunit ] || fail "this initrd carries no urunit"
run=/newroot/run/urunc
$BB mkdir -p "$run" || fail "could not create $run"
$BB cp /urunit "$run/urunit" || fail "could not copy urunit into the new root"
$BB chmod 0755 "$run/urunit"
if [ -x /urunit-agent ]; then
  $BB cp /urunit-agent "$run/urunit-agent" || fail "could not copy urunit-agent into the new root"
  $BB chmod 0755 "$run/urunit-agent"
fi
if [ -f /urunit.conf ]; then
  $BB cp /urunit.conf "$run/urunit.conf" || fail "could not copy urunit.conf into the new root"
  export URUNIT_CONFIG=/run/urunc/urunit.conf
else
  echo "container-init: no urunit.conf in the initrd; urunit runs the command as root with no environment" >&2
fi

# hull: every other export is its own virtio-fs device and gets mounted here.
if [ -f /urunc-mounts ]; then
  while IFS="	" read -r _tag _dest _mode; do
    [ -n "$_tag" ] && [ -n "$_dest" ] || continue
    $BB mkdir -p "/newroot$_dest"
    if [ "$_mode" = ro ]; then
      $BB mount -t virtiofs -o ro "$_tag" "/newroot$_dest" || fail "could not mount export $_tag at $_dest"
    else
      $BB mount -t virtiofs "$_tag" "/newroot$_dest" || fail "could not mount export $_tag at $_dest"
    fi
  done < /urunc-mounts
fi

# hull: the network files, which Linux hosts bind-mount into the rootfs.
if [ -s /urunc-resolv.conf ] || [ -s /urunc-hosts ] || [ -s /urunc-hostname ]; then
  $BB mkdir -p /newroot/etc
  [ -s /urunc-resolv.conf ] && $BB cp /urunc-resolv.conf /newroot/etc/resolv.conf
  [ -s /urunc-hosts ] && $BB cp /urunc-hosts /newroot/etc/hosts
  [ -s /urunc-hostname ] && $BB cp /urunc-hostname /newroot/etc/hostname
  $BB chmod 0644 /newroot/etc/resolv.conf /newroot/etc/hosts /newroot/etc/hostname 2>/dev/null
fi

$BB mkdir -p /newroot/dev
$BB mount --move /dev /newroot/dev || fail "could not move /dev into the new root"
$BB mkdir -p /newroot/dev/pts /newroot/dev/shm
$BB mount -t devpts -o gid=5,mode=0620,ptmxmode=0666 devpts /newroot/dev/pts || fail "could not mount devpts"
$BB mount -t tmpfs -o mode=1777 shm /newroot/dev/shm || fail "could not mount /dev/shm"

# hull: the command comes as a file, one argument per line, since the kernel
# command line splits on whitespace. It replaces the arguments after "--".
if [ -f /urunc-cmd ]; then
  set --
  while IFS= read -r _a; do set -- "$@" "$_a"; done < /urunc-cmd
fi

# switch_root execs urunit directly, so a bare command such as "bash" is
# resolved against the new root's standard directories first.
cmd="$1"
shift 2>/dev/null || true
case "$cmd" in
  /*) ;;
  *)
    for d in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
      if [ -x "/newroot$d/$cmd" ]; then
        cmd="$d/$cmd"
        break
      fi
    done
    ;;
esac

exec $BB switch_root /newroot /run/urunc/urunit "$cmd" "$@"
